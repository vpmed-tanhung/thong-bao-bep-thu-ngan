# Chỉ điền khóa của nhà cung cấp được chọn.
TTS_PROVIDER=zalo
PORT=3000

# Frontend được phép gọi API. Phân cách nhiều địa chỉ bằng dấu phẩy.
ALLOWED_ORIGINS=https://vpmed-tanhung.github.io

# Chỉ bật khi mở quay.html trực tiếp bằng file:// trên máy tính.
ALLOW_FILE_ORIGIN=false

# Khóa Firebase Web mới sau khi thu hồi khóa đã lộ trên GitHub.
FIREBASE_WEB_API_KEY=

# Giới hạn an toàn cho thông báo ngắn tại quầy.
MAX_TEXT_LENGTH=120
RATE_LIMIT_PER_MINUTE=60
TTS_CACHE_TTL_MS=3600000
AUDIO_POLL_TIMEOUT_MS=120000

# ---------- FPT.AI ----------
FPT_AI_API_KEY=
FPT_AI_VOICE=banmai
FPT_AI_SPEED=0
FPT_AI_API_URL=https://api.fpt.ai/hmi/tts/v5

# ---------- Zalo AI ----------
ZALO_AI_API_KEY=
ZALO_AI_SPEAKER_ID=1
ZALO_AI_SPEED=1.0
ZALO_AI_API_URL=https://api.zalo.ai/v1/tts/synthesize

# ---------- Google Cloud Text-to-Speech ----------
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=vi-VN-Neural2-A
GOOGLE_TTS_SPEAKING_RATE=1.0
